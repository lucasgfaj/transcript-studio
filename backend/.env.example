# Optional overrides (copy to backend/.env). Preferences changed in the interface
# (Models / Context pages) are stored in the database and take precedence.

# Ollama server (Windows Ollama seen from WSL with mirrored networking)
STUDIO_OLLAMA_URL=http://localhost:11434

# Defaults before anything is chosen in the interface
STUDIO_DEFAULT_LLM=qwen3.5:4b
STUDIO_DEFAULT_WHISPER=large-v3-turbo

# GPU memory, used to tell which LLMs fit entirely on the GPU
STUDIO_GPU_MEMORY_GB=6

# Load Whisper when the server starts (first transcription starts at once)
STUDIO_WHISPER_PRELOAD=true
STUDIO_WHISPER_BATCH_SIZE=16

# Where meetings, audio and the SQLite database live
# STUDIO_DATA_DIR=/home/you/transcript-studio/data
